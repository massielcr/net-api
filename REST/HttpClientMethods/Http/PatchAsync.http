@owner = massielcr
@repo = my-test-http-repo

### PatchAsync(Uri, HttpContent) -                        ----    PatchAsync_UpdateRepoVisibilityAsync      visibility:public, private
PATCH {{HostAddress}}/patchasync/repos/{{owner}}/{{repo}}/update HTTP/2
Accept : application/json
Content-Type: application/json
{
  "visibility": "public"
}


### PatchAsync(String, HttpContent, CancellationToken)    ----    PatchAsync_UpdateBatchIssuesAsync     state:open, closed, state_reason:not_planned, duplicate, reopened
PATCH {{HostAddress}}/patchasync/repos/{{owner}}/{{repo}}/issues/updatebatch?cid=1 HTTP/2
Accept : application/json
Content-Type: application/json
{
